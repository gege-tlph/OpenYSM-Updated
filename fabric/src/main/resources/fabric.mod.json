{
  "schemaVersion": 1,
  "id": "yes_steve_model",
  "version": "${version}",
  "name": "Yes Steve Model",
  "description": "Replace your player model with custom Bedrock/Gecko models, with animations, texture switching and an animation roulette. Unofficial fork of OpenYSM for Minecraft 26.1.2 on Fabric.",
  "authors": ["Tianjin Accessible Care Innovation Development Co., Ltd."],
  "contributors": ["OpenYSM-Updated contributors"],
  "contact": {
    "homepage": "https://github.com/gege-tlph/OpenYSM-Updated",
    "sources": "https://github.com/gege-tlph/OpenYSM-Updated",
    "issues": "https://github.com/gege-tlph/OpenYSM-Updated/issues"
  },
  "license": "MIT",
  "icon": "yesstevemodel.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.elfmcys.yesstevemodel.fabric.YesSteveModelFabric"
    ],
    "client": [
      "com.elfmcys.yesstevemodel.fabric.client.YesSteveModelFabricClient"
    ],
    "cardinal-components-entity": [
      "com.elfmcys.yesstevemodel.fabric.YsmComponents"
    ]
  },
  "mixins": [
    "yes_steve_model.mixins.json",
    "yes_steve_model_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": "~26.1.2",
    "java": ">=25"
  },
  "custom": {
    "cardinal-components": [
      "yes_steve_model:star_models",
      "yes_steve_model:auth_models",
      "yes_steve_model:model_info",
      "yes_steve_model:projectile_model",
      "yes_steve_model:vehicle_model"
    ]
  }
}
